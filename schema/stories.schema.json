{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/kengou/Jira-ticket-creator/schema/stories.schema.json",
  "title": "jira-ai-creator Configuration Schema",
  "description": "Schema for defining Jira issues to be created by jira-ai-creator",
  "type": "object",
  "required": ["schemaVersion", "defaults", "issues"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0",
      "description": "Schema version (currently only 1.0 is supported)"
    },
    "defaults": {
      "$ref": "#/definitions/Defaults"
    },
    "validation": {
      "$ref": "#/definitions/Validation"
    },
    "options": {
      "$ref": "#/definitions/Options"
    },
    "issues": {
      "type": "array",
      "description": "List of issues to create",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Issue"
      }
    }
  },
  "definitions": {
    "Defaults": {
      "type": "object",
      "description": "Global default values applied to all issues",
      "required": ["projectKey"],
      "additionalProperties": false,
      "properties": {
        "projectKey": {
          "type": "string",
          "description": "Jira project key (e.g., POM, MYPROJ)",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9]*$"
        },
        "issueType": {
          "type": "string",
          "description": "Default issue type"
        },
        "priority": {
          "type": "string",
          "description": "Default priority"
        },
        "reporter": {
          "type": "string",
          "description": "Default reporter username"
        },
        "assignee": {
          "type": ["string", "null"],
          "description": "Default assignee username (null for unassigned)"
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Labels added to all issues"
        },
        "components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Default components"
        },
        "fixVersions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Default fix versions"
        },
        "customFields": {
          "type": "object",
          "description": "Default custom field values",
          "additionalProperties": true
        },
        "descriptionTemplate": {
          "type": "string",
          "description": "Template for rendering descriptions with variables"
        }
      }
    },
    "Validation": {
      "type": "object",
      "description": "Validation rules",
      "additionalProperties": false,
      "properties": {
        "strictMode": {
          "type": "boolean",
          "default": false,
          "description": "If true, warnings are treated as errors"
        },
        "allowedIssueTypes": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Restrict allowed issue types"
        },
        "allowedPriorities": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Restrict allowed priorities"
        },
        "requiredFields": {
          "type": "object",
          "description": "Required template variables per issue type",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "Options": {
      "type": "object",
      "description": "Execution options",
      "additionalProperties": false,
      "properties": {
        "idempotencyEnabled": {
          "type": "boolean",
          "default": true,
          "description": "Skip issues that were already created (tracked in state file)"
        },
        "continueOnError": {
          "type": "boolean",
          "default": false,
          "description": "Continue creating issues even if one fails"
        },
        "dryRun": {
          "type": "boolean",
          "default": false,
          "description": "Simulate without making API calls"
        },
        "verbose": {
          "type": "boolean",
          "default": false,
          "description": "Enable verbose output"
        },
        "maxConcurrency": {
          "type": "integer",
          "default": 5,
          "minimum": 1,
          "description": "Maximum concurrent API requests (reserved for future use)"
        }
      }
    },
    "Issue": {
      "type": "object",
      "description": "A Jira issue to create",
      "required": ["id", "issueType", "summary"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique internal identifier (e.g., STORY-001, EPIC-AUTH-001)",
          "minLength": 1,
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "issueType": {
          "type": "string",
          "description": "Jira issue type (Epic, Story, Bug, Task, etc.)",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "description": "Issue title",
          "minLength": 1,
          "maxLength": 255
        },
        "description": {
          "type": "string",
          "description": "Issue description (supports Jira wiki markup)"
        },
        "parent": {
          "type": "string",
          "description": "Internal ID of parent epic (for stories under epics)"
        },
        "epicName": {
          "type": "string",
          "description": "Epic name (REQUIRED for Epic issue type)"
        },
        "epicLink": {
          "type": "string",
          "description": "Link to existing Jira epic key (e.g., POM-123)"
        },
        "priority": {
          "type": "string",
          "description": "Override priority for this issue"
        },
        "assignee": {
          "type": "string",
          "description": "Override assignee for this issue"
        },
        "reporter": {
          "type": "string",
          "description": "Override reporter for this issue"
        },
        "labels": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Additional labels (merged with defaults)"
        },
        "components": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Override components for this issue"
        },
        "fixVersions": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Override fix versions for this issue"
        },
        "customFields": {
          "type": "object",
          "description": "Custom field values for this issue",
          "additionalProperties": true
        },
        "dependsOn": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Internal IDs of issues that must be created first"
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/definitions/IssueLink" },
          "description": "Issue links to create"
        },
        "templateVars": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Variables for description template"
        },
        "attachments": {
          "type": "array",
          "items": { "$ref": "#/definitions/Attachment" },
          "description": "Files to attach to the issue"
        },
        "metadata": {
          "type": "object",
          "description": "Arbitrary metadata (not sent to Jira)",
          "additionalProperties": true
        }
      },
      "if": {
        "properties": { "issueType": { "const": "Epic" } }
      },
      "then": {
        "required": ["epicName"]
      }
    },
    "IssueLink": {
      "type": "object",
      "description": "A link between two issues",
      "required": ["type", "target"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "description": "Link type (e.g., blocks, relates to, duplicates)",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "description": "Internal ID of the target issue",
          "minLength": 1
        },
        "comment": {
          "type": "string",
          "description": "Optional comment on the link"
        }
      }
    },
    "Attachment": {
      "type": "object",
      "description": "A file attachment",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "description": "Path to the file",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "description": "Optional description of the attachment"
        }
      }
    }
  }
}

